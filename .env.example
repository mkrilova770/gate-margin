# ── Gate (optional): signed max borrow for liquidity column ─────────────────
# Without keys, borrow liquidity falls back to public margin pair cap (`max_quote_amount`).
# With keys, uses GET /api/v4/margin/uni/borrowable (per BASE + BASE_USDT), concurrency-limited.
GATE_API_KEY=
GATE_API_SECRET=
# GATE_BORROWABLE_CONCURRENCY=18
# GATE_BORROWABLE_TIMEOUT_MS=15000
# Если уникальных баз ≤ порога — spot/margin по одной паре (быстрее), иначе полные списки Gate.
# GATE_PAIR_FETCH_THRESHOLD=140
# GATE_PUBLIC_PAIR_CONCURRENCY=16

# ── Bitget (optional): richer borrow quotes on Bitget adapter ─────────────
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
# BITGET_ACCOUNT_MAX_BORROW=1

# ── Client / scan ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_SCAN_TIMEOUT_MS=120000

# Read-only mirror: if set, this server proxies GET /api/scan to that origin (unless same host or disabled).
# SCAN_UPSTREAM_URL=https://your-scanner.up.railway.app
# SCAN_UPSTREAM_TIMEOUT_MS=120000
# SCAN_UPSTREAM_DISABLED=1
